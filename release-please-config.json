{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": true,
  "plugins": [],
  "packages": {
    "apps/extension": {
      "release-type": "simple",
      "package-name": "extension",
      "component": "extension",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "json", "path": "manifest.json", "jsonpath": "$.version" },
        { "type": "json", "path": "manifest-chrome-brave-edge.json", "jsonpath": "$.version" },
        { "type": "json", "path": "manifest-safari-firefox.json", "jsonpath": "$.version" }
      ]
    },
    "apps/website": {
      "release-type": "node",
      "package-name": "website",
      "component": "website"
    },
    "apps/cli": {
      "release-type": "python",
      "package-name": "thecode",
      "component": "cli"
    },
    "apps/android": {
      "release-type": "simple",
      "package-name": "android",
      "component": "android",
      "extra-files": ["app/build.gradle"]
    },
    "apps/apple": {
      "release-type": "simple",
      "package-name": "apple",
      "component": "apple"
    }
  }
}
