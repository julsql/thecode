<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.TheCode" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorOnPrimary">@color/background_dark</item>
        <item name="colorSecondary">@color/brand_green</item>
        <item name="colorOnSecondary">@color/background_dark</item>

        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorSurfaceVariant">@color/surface_variant_dark</item>
        <item name="colorOnSurface">@color/on_surface_dark</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant_dark</item>
        <item name="colorOutline">@color/outline_dark</item>

        <!-- API 23+ : un attribut de theme inconnu est ignore silencieusement
             par les versions anterieures, contrairement a un appel de methode.
             minSdk vaut 21, d'ou l'annotation. -->
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/background_dark</item>

        <item name="materialAlertDialogTheme">@style/ThemeOverlay.TheCode.MaterialAlertDialog</item>
    </style>

    <style name="Theme.TheCode.Splash" parent="Theme.TheCode">
        <item name="android:windowBackground">@color/background_dark</item>
        <!-- API 23+ : un attribut de theme inconnu est ignore silencieusement
             par les versions anterieures, contrairement a un appel de methode.
             minSdk vaut 21, d'ou l'annotation. -->
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>

</resources>
