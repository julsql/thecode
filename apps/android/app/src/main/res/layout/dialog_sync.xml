<?xml version="1.0" encoding="utf-8"?>
<!-- Connexion au service de synchronisation.

     Les identifiants demandés ici sont ceux du compte, jamais la clef
     maîtresse : s'authentifier avec celle-ci ferait qu'une faiblesse du
     service exposerait les mots de passe eux-mêmes. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:text="@string/sync_explainer"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/sync_endpoint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/syncEndpoint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/sync_email">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/syncEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/sync_password"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/syncPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Caché tant que le service n'a pas dit quel client Google il
             accepte : sans lui, le jeton serait refusé de toute façon. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/syncGoogle"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sync_google"
            android:visibility="gone" />

        <!-- La création du compte, l'abonnement et les appareils se gèrent sur
             le site : sans ce rappel, un nouveau venu reste bloqué devant un
             formulaire de connexion sans compte à y mettre. -->
        <TextView
            android:id="@+id/syncSignUp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoLink="web"
            android:paddingTop="8dp"
            android:text="@string/sync_no_account"
            android:textAppearance="?attr/textAppearanceBodySmall" />
    </LinearLayout>
</ScrollView>
