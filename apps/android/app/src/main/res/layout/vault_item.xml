<?xml version="1.0" encoding="utf-8"?>
<!-- Une entrée du carnet : ce qui a été enregistré, et sous quels réglages. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/entryLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            tools:text="google.com" />

        <TextView
            android:id="@+id/entryDomains"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            tools:text="google.com, google.fr, youtube.com" />

        <TextView
            android:id="@+id/entrySettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            tools:text="20 caractères, aA#1 — v1, compteur 1" />

        <!-- L'action etait cachee derriere un appui sur la carte : rien ne le
             disait. Elle s'affiche maintenant, avec son nom. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/entryAction"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            tools:text="Renouveler le mot de passe" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
