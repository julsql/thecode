<?xml version="1.0" encoding="utf-8"?>
<!-- Annonce du passage a la v2, a l'ouverture.

     Fermer la fait revenir la prochaine fois ; seule la case a cocher la
     retire pour de bon : une annonce qu'on n'a pas eu le temps de lire ne doit
     pas disparaitre pour toujours. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/v2_notice"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/v2NoticeNeverAgain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/v2_notice_never_again" />
</LinearLayout>
