<?xml version="1.0" encoding="utf-8"?>
<!-- Écran du carnet.

     Le carnet ne contient aucun mot de passe : seulement de quoi rejouer une
     dérivation. Cet écran sert à voir ce qui est enregistré et à retrouver
     quels réglages s'appliquent à quel site. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/vaultToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/vault_title" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Affiche tant que la session n'est pas authentifiee. Le contenu
                 du carnet n'est jamais rendu avant : une capture du selecteur
                 d'applications suffirait a le reveler. -->
            <LinearLayout
                android:id="@+id/vaultLocked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/vault_locked_subtitle"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/vaultUnlockAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/vault_unlock" />

                <!-- Seule issue quand le verrou ne s'ouvre plus : efface le
                     carnet local et le verrou, apres confirmation. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/vaultForgotAction"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vault_lock_forgot" />
            </LinearLayout>

            <!-- Affiche tant qu'aucun compte n'est lie : la synchronisation
                 est la principale raison d'en creer un, et rien ne le disait.
                 Aucune mention d'offre ni de prix : les regles des magasins
                 d'applications interdisent d'y orienter vers un paiement. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/vaultSyncPitch"
                style="?attr/materialCardViewOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sync_pitch_title"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="4dp"
                        android:text="@string/sync_pitch_body"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <!-- Ouvre la meme connexion que le menu : un compte
                             deja cree se lie sans quitter l'application. -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/vaultSyncPitchSignIn"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="@string/sync_pitch_sign_in" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/vaultSyncPitchAction"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sync_pitch_action" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sous la synchronisation, affiché seulement quand il n'y a
                 rien : une liste vide sans explication laisse croire à une
                 panne. -->
            <TextView
                android:id="@+id/vaultEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vault_empty"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/vaultList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
